---
/**
 * ConversionFooter — final registration message, navigation, contact, and
 * the current copyright year (computed, not hardcoded — the legacy site still
 * showed 2017, per frontend.md 11).
 */
import CTAGroup from "./CTAGroup.astro";
import BrandLockup from "./BrandLockup.astro";
import Provisional from "./Provisional.astro";
import { event, dateLocationLabel, registerAction } from "../content/event.ts";
import { releaseNavigation } from "../content/navigation.ts";

const year = new Date().getFullYear();
---

<footer class="footer" aria-labelledby="footer-title">
  <div class="container">
    <div class="footer__cta">
      <h2 class="footer__title" id="footer-title">See you at the start line</h2>
      <p class="footer__meta">{dateLocationLabel}</p>
      <CTAGroup actions={[registerAction]} />
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <BrandLockup theme="dark" href={false} loading="lazy" />
      </div>

      <nav class="footer__nav" aria-label="Footer">
        {
          releaseNavigation.map((group) => (
            <div class="footer__nav-group">
              <h3 class="eyebrow">{group.label}</h3>
              <ul role="list">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="footer__contact">
        <h3 class="eyebrow">Get in touch</h3>
        <p>
          <Provisional value={event.contactEmail}>
            <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>
          </Provisional>
        </p>
        <ul class="footer__social" role="list">
          {
            event.social.map((item) => (
              <li>
                <Provisional value={item.href}>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.label}
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                </Provisional>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="footer__legal">
      © {year} Fort Lauderdale 13.1. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--navy-950);
    color: var(--text-on-dark);
    padding-block: var(--section-padding-block) var(--space-6);
  }

  .footer__cta {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block-end: var(--space-9);
    border-block-end: 1px solid var(--border-on-dark);
  }

  .footer__title {
    font-size: var(--text-4xl);
  }

  .footer__meta {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--yellow-500);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .footer__brand {
    --lockup-mark-height: 4rem;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-5);
  }

  .footer__nav h3,
  .footer__contact h3 {
    font-size: var(--text-2xs);
    color: var(--aqua-300);
    margin-block-end: var(--space-3);
  }

  .footer__nav ul,
  .footer__social {
    display: grid;
    gap: var(--space-2);
  }

  .footer__nav a,
  .footer__contact a {
    display: inline-block;
    padding-block: 0.15rem;
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
  }

  .footer__nav a:hover,
  .footer__contact a:hover {
    color: var(--yellow-500);
  }

  .footer__social {
    margin-block-start: var(--space-4);
  }

  .footer__legal {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--border-on-dark);
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
