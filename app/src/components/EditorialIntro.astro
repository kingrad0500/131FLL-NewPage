---
/**
 * EditorialIntro — large heading, narrow measure, selectable semantic copy.
 * Reveal motion is deferred to Phase 9; the text is fully visible without it.
 */
import { editorialIntro } from "../content/home.ts";
import type { EditorialBlock, SectionSurface } from "../content/types.ts";

interface Props {
  content?: EditorialBlock;
  surface?: SectionSurface;
  id?: string;
}

const {
  content = editorialIntro,
  surface = "warm",
  id = "intro",
}: Props = Astro.props;

const titleId = `${id}-title`;
---

<section class:list={["intro", "section", `section--${surface}`]} aria-labelledby={titleId}>
  <div class="container">
    <div class="intro__grid">
      <p class="eyebrow">{content.eyebrow}</p>
      <div class="intro__body">
        <h2 class="section__title" id={titleId}>{content.title}</h2>
        {content.body.map((para) => <p class="measure">{para}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-6) var(--space-8);
    align-items: start;
  }

  .intro__body {
    display: grid;
    gap: var(--space-5);
  }

  .intro__body p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  @media (max-width: 52rem) {
    .intro__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
