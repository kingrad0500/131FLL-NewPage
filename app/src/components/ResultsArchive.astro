---
/**
 * ResultsArchive — year-by-year links out to the results host.
 *
 * Results live on Athlinks; this component's only job is to get someone to the
 * right year and distance in as few decisions as possible. The most recent
 * year leads and is always expanded; older years are collapsed so the archive
 * does not bury it.
 *
 * Gaps in the archive are shown as they are rather than hidden — a missing
 * year is information, not an error.
 */
import type { ResultsYear } from "../content/types.ts";

interface Props {
  archive: ResultsYear[];
}

const { archive }: Props = Astro.props;
const [latest, ...older] = archive;
---

<div class="archive">
  <section class="archive__latest" aria-labelledby="latest-results">
    <h3 class="archive__year" id="latest-results">{latest.year}</h3>
    <ul class="archive__races archive__races--featured" role="list">
      {
        latest.races.map((race) => (
          <li>
            <a class="resultlink u-unstyled-link" href={race.href} target="_blank" rel="noopener">
              <span class="resultlink__distance">{race.distance}</span>
              <span class="resultlink__meta">
                View results
                <span class="visually-hidden"> (opens in a new tab)</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    older.length > 0 && (
      <div class="archive__older">
        <h3 class="archive__older-title">Earlier years</h3>
        {older.map((year) => (
          <details class="archive__year-group">
            <summary class="archive__year-summary">
              <span>{year.year}</span>
              <span class="archive__count">
                {year.races.length} {year.races.length === 1 ? "race" : "races"}
              </span>
            </summary>
            <ul class="archive__races" role="list">
              {year.races.map((race) => (
                <li>
                  <a href={race.href} target="_blank" rel="noopener">
                    {race.distance}
                    <span class="visually-hidden"> results (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    )
  }
</div>

<style>
  .archive {
    display: grid;
    gap: var(--space-9);
    margin-block-start: var(--space-7);
  }

  .archive__year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wider);
    color: var(--text-secondary);
    margin-block-end: var(--space-4);
  }

  .archive__races--featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
  }

  .resultlink {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background-color: var(--surface-raised, #fff);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-micro) var(--ease-standard),
      transform var(--duration-micro) var(--ease-standard);
  }

  .resultlink:hover {
    border-color: var(--accent-coastal-on-light);
    transform: translateY(-2px);
  }

  .resultlink__distance {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .resultlink__meta {
    font-size: var(--text-sm);
    color: var(--accent-coastal-on-light);
  }

  .archive__older-title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-4);
  }

  .archive__year-group {
    border-block-start: var(--border-width) solid var(--border-subtle);
  }

  .archive__year-group:last-of-type {
    border-block-end: var(--border-width) solid var(--border-subtle);
  }

  .archive__year-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    cursor: pointer;
    list-style: none;
  }

  .archive__year-summary::-webkit-details-marker {
    display: none;
  }

  .archive__count {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .archive__races {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    padding-block-end: var(--space-5);
  }

  @media (prefers-reduced-motion: reduce) {
    .resultlink {
      transition: none;
    }

    .resultlink:hover {
      transform: none;
    }
  }
</style>
