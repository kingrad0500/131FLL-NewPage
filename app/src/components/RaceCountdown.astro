---
/**
 * RaceCountdown — days/hours/minutes/seconds to the start.
 *
 * The full date is rendered as visible text, so the countdown is an
 * enhancement rather than the only source of the fact. Server-rendered values
 * are placeholders and fill on hydration to avoid a build-time/runtime
 * mismatch; the timer stops cleanly once the race begins.
 *
 * Accuracy depends on DEC-009 — the start timestamp is unverified.
 */
import { event, dateLocationLabel } from "../content/event.ts";

interface Props {
  /** ISO 8601 with offset. */
  startsAt?: string;
  eyebrow?: string;
  title?: string;
  id?: string;
}

const {
  startsAt = event.startsAt,
  eyebrow = "Countdown",
  title = "To race day",
  id = "countdown",
}: Props = Astro.props;

const titleId = `${id}-title`;

const units = [
  { key: "days", label: "Days" },
  { key: "hours", label: "Hours" },
  { key: "minutes", label: "Minutes" },
  { key: "seconds", label: "Seconds" },
] as const;
---

<section class="countdown section section--deepest" aria-labelledby={titleId}>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section__title" id={titleId}>{title}</h2>

    <div
      class="countdown__grid"
      data-countdown
      data-target={startsAt}
      role="timer"
      aria-live="off"
    >
      {
        units.map((unit) => (
          <div class="countdown__unit">
            <span class="countdown__value" data-unit={unit.key}>
              --
            </span>
            <span class="countdown__label">{unit.label}</span>
          </div>
        ))
      }
    </div>

    <p class="countdown__date">
      <span class="visually-hidden">Race day: </span>{dateLocationLabel}
    </p>

    <p class="countdown__ended" data-countdown-ended hidden>
      Race day is here. Good luck out there.
    </p>
  </div>
</section>

<style>
  .countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-7) var(--space-5);
    max-width: 46rem;
  }

  .countdown__unit {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-2);
    border: var(--border-width) solid var(--border-on-dark);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .countdown__value {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    line-height: 1;
    color: var(--yellow-500);
    font-variant-numeric: tabular-nums;
  }

  .countdown__label {
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  .countdown__date {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--text-on-dark);
  }

  .countdown__ended {
    margin-block-start: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--yellow-500);
  }

  @media (max-width: 34rem) {
    .countdown__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");

  const initCountdown = (root: HTMLElement) => {
    const target = new Date(root.dataset.target ?? "").getTime();

    if (Number.isNaN(target)) {
      root.hidden = true;
      return;
    }

    const endedMessage = root.parentElement?.querySelector<HTMLElement>(
      "[data-countdown-ended]",
    );
    const outputs = new Map(
      Array.from(root.querySelectorAll<HTMLElement>("[data-unit]")).map((el) => [
        el.dataset.unit,
        el,
      ]),
    );

    let timer = 0;

    const tick = () => {
      const remaining = target - Date.now();

      if (remaining <= 0) {
        window.clearInterval(timer);
        root.hidden = true;
        if (endedMessage) endedMessage.hidden = false;
        return;
      }

      const total = Math.floor(remaining / 1000);
      const next: Record<string, string> = {
        days: String(Math.floor(total / 86400)),
        hours: pad(Math.floor((total % 86400) / 3600)),
        minutes: pad(Math.floor((total % 3600) / 60)),
        seconds: pad(total % 60),
      };

      // Only "seconds" changes on most ticks; writing the other three every
      // second dirties layout for nodes whose text is already correct.
      for (const [unit, el] of outputs) {
        const value = next[unit ?? ""];
        if (value !== undefined && el.textContent !== value) {
          el.textContent = value;
        }
      }
    };

    const start = () => {
      window.clearInterval(timer);
      tick();
      timer = window.setInterval(tick, 1000);
    };

    // No reason to run in a background tab; resync on return.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) window.clearInterval(timer);
      else start();
    });

    start();
  };

  document
    .querySelectorAll<HTMLElement>("[data-countdown]")
    .forEach(initCountdown);
</script>
