---
/**
 * EventTicker — continuous event-information bar above the hero.
 *
 * Content is duplicated for a seamless loop; the duplicate is aria-hidden so
 * screen readers hear the facts once. Motion pauses on hover and on keyboard
 * focus, and reduced motion drops to a static wrapped list.
 *
 * AGENTS.md: the ticker must never be the only source of essential
 * information. Date, location, and distances all appear in page content too.
 */
import { tickerItems } from "../content/event.ts";

const SEPARATOR = "•";

/*
 * A seamless CSS marquee needs two real copies of the content in the DOM. They
 * are generated from one loop so the copies cannot drift apart; the clone is
 * aria-hidden so the facts are announced once.
 */
const TRACKS = [false, true];
---

<div class="ticker" role="region" aria-label="Event details">
  <div class="ticker__viewport">
    {
      TRACKS.map((isClone) => (
        <ul class="ticker__track" role="list" aria-hidden={isClone || undefined}>
          {tickerItems.map((item) => (
            <li class="ticker__item">
              <span>{item}</span>
              <span class="ticker__sep" aria-hidden="true">
                {SEPARATOR}
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    background-color: var(--yellow-500);
    color: var(--navy-950);
    border-block-end: 1px solid rgba(0, 31, 69, 0.12);
  }

  .ticker__viewport {
    display: flex;
    align-items: center;
    height: var(--ticker-height);
    overflow: hidden;
    /* Pause when a focusable descendant is focused. */
    &:has(:focus-visible) .ticker__track {
      animation-play-state: paused;
    }
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    padding: var(--space-2) 0;
    /* A running transform animation self-promotes; will-change would only
       pin a full-width layer for the life of the page. */
    animation: ticker-scroll var(--duration-marquee) linear infinite;
  }

  .ticker__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-inline-end: var(--space-4);
    white-space: nowrap;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .ticker__sep {
    opacity: 0.55;
  }

  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* Static wrapped fallback — no movement, all content visible. */
  @media (prefers-reduced-motion: reduce) {
    /* Wrapped content needs to grow past the single-line track height. */
    .ticker__viewport {
      overflow: visible;
      height: auto;
      min-height: var(--ticker-height);
    }

    .ticker__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-1);
    }

    .ticker__track[aria-hidden="true"] {
      display: none;
    }
  }
</style>
