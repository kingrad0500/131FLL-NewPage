---
/**
 * MediaHero — full-height opening scene.
 *
 * Media degrades in a defined order, so the hero is never broken:
 *   1. video + poster  → muted looping video, poster painted underneath
 *   2. image only      → static cinematic image
 *   3. neither         → designed placeholder (current state, DEC-005)
 *
 * Reduced motion and blocked autoplay both land on the poster or image; the
 * headline and CTAs never depend on media loading.
 */
import CTAGroup from "./CTAGroup.astro";
import PlaceholderMedia from "./PlaceholderMedia.astro";
import type { Hero } from "../content/types.ts";

interface Props {
  hero: Hero;
}

const { hero }: Props = Astro.props;
const { media } = hero;

const videoSrc = media.video && media.poster ? media.video : null;
const stillSrc = media.desktopImage ?? media.poster;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      videoSrc ? (
        <video
          class="hero__video"
          src={videoSrc}
          poster={media.poster!}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
          data-hero-video
          style={`object-position: ${media.focalPointDesktop}`}
        />
      ) : stillSrc ? (
        <img
          class="hero__image"
          src={stillSrc}
          alt={media.imageAlt}
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
          style={`object-position: ${media.focalPointDesktop}`}
        />
      ) : (
        <PlaceholderMedia
          fill
          label="Homepage hero video or cinematic photograph"
          intendedAlt={media.imageAlt}
        />
      )
    }
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content container">
    <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title" id="hero-title">{hero.title}</h1>
    <p class="hero__subtitle measure">{hero.subtitle}</p>
    <CTAGroup actions={hero.actions} class="hero__actions" />
  </div>
</section>

{/* Marks where the hero ends, so the header knows when to go solid. */}
<div data-header-sentinel aria-hidden="true"></div>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 92svh;
    isolation: isolate;
    background-color: var(--navy-950);
    color: var(--text-on-dark);
    overflow: hidden;
  }

  .hero__media,
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Pausing offscreen and under reduced motion is handled by the script. */
  .hero__video,
  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Keep the placeholder notice clear of the fixed topbar. */
  .hero__media {
    --placeholder-inset: calc(var(--topbar-height) + var(--space-5));
  }

  .hero__overlay {
    background: var(--hero-overlay);
  }

  .hero__content {
    padding-block: clamp(4rem, 12vh, 8rem);
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .hero__eyebrow {
    color: var(--yellow-500);
  }

  .hero__title {
    font-family: var(--font-expressive);
    font-size: var(--text-6xl);
    font-style: italic;
    font-weight: var(--weight-bold);
    line-height: 0.95;
    letter-spacing: var(--tracking-tight);
    color: var(--white);
    text-wrap: balance;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-on-dark-muted);
  }

  .hero__actions {
    margin-block-start: var(--space-3);
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: 88svh;
    }

    .hero__content {
      justify-items: stretch;
    }
  }

</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  const initHeroVideo = (video: HTMLVideoElement) => {
    const applyMotionPreference = () => {
      if (reduced.matches) {
        video.pause();
        video.removeAttribute("autoplay");
      } else if (video.paused) {
        video.play().catch(() => {
          /* Autoplay blocked (iOS low-power) — the poster stands in. */
        });
      }
    };

    applyMotionPreference();
    reduced.addEventListener("change", applyMotionPreference);

    // Pause offscreen to keep the performance budget.
    new IntersectionObserver(
      ([entry]) => {
        if (reduced.matches) return;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.1 },
    ).observe(video);
  };

  document
    .querySelectorAll<HTMLVideoElement>("[data-hero-video]")
    .forEach(initHeroVideo);
</script>
