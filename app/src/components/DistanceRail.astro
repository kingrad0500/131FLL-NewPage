---
/**
 * DistanceRail — horizontal showcase of the confirmed distances.
 *
 * Built on native CSS scroll-snap (plan.md, step 8) so it works with touch
 * swipe, trackpad, and scrollbar before any script loads. Script adds only
 * previous/next buttons and progress reporting.
 *
 * The rail is the one place horizontal overflow is intentional; it is scoped
 * to the track element and never reaches the page.
 *
 * Keyboard: each card is a focusable group reachable by Tab, and the arrow
 * buttons move the rail. There is no page-scroll hijacking.
 */
import PlaceholderMedia from "./PlaceholderMedia.astro";
import Provisional from "./Provisional.astro";
import type { Distance } from "../content/types.ts";
import { activeDistances } from "../content/distances.ts";

interface Props {
  distances?: Distance[];
  eyebrow?: string;
  title?: string;
  id?: string;
}

const {
  distances = activeDistances,
  eyebrow = "Choose Your Race",
  title = "A race for every pace",
  id = "distances",
}: Props = Astro.props;

const titleId = `${id}-title`;
const trackId = `${id}-track`;

const metaFor = (distance: Distance) => [
  { label: "Start", value: distance.startTime },
  { label: "Entry", value: distance.price },
];
---

<section
  class="rail section section--muted"
  id={id}
  aria-labelledby={titleId}
  data-rail
>
  <div class="container">
    <div class="rail__header">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="section__title" id={titleId}>{title}</h2>
      </div>

      <div class="rail__controls">
        <button
          class="btn btn--secondary rail__btn"
          type="button"
          data-rail-prev
          aria-controls={trackId}
        >
          <span class="visually-hidden">Previous distance</span>
          <span aria-hidden="true">←</span>
        </button>
        <button
          class="btn btn--secondary rail__btn"
          type="button"
          data-rail-next
          aria-controls={trackId}
        >
          <span class="visually-hidden">Next distance</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <ul
    class="rail__track"
    id={trackId}
    data-rail-track
    role="list"
    tabindex="0"
    aria-label="Race distances — scroll horizontally"
  >
    {
      distances.map((distance, index) => (
        <li
          class="card"
          role="listitem"
          aria-label={`${distance.name}, ${index + 1} of ${distances.length}`}
        >
          <div class="card__media">
            {distance.image ? (
              <img
                src={distance.image}
                alt={distance.imageAlt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <PlaceholderMedia
                label={`${distance.name} image`}
                intendedAlt={distance.imageAlt}
                ratio="4 / 3"
              />
            )}
          </div>

          <div class="card__body">
            <h3 class="card__name">{distance.shortName}</h3>
            <p class="card__full-name">{distance.name}</p>
            <p class="card__description">{distance.description}</p>

            <dl class="card__meta">
              {metaFor(distance).map((row) => (
                <div>
                  <dt>{row.label}</dt>
                  <dd>
                    <Provisional value={row.value} />
                  </dd>
                </div>
              ))}
            </dl>

            <a class="card__link" href={distance.detailsUrl}>
              Learn more<span class="visually-hidden"> about the {distance.name}</span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="container">
    <p class="rail__progress" data-rail-progress aria-live="polite"></p>
  </div>
</section>

<style>
  .rail__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-end: var(--space-7);
  }

  .rail__controls {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* Icon-button delta over the shared .btn--secondary recipe. */
  .rail__btn {
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    font-size: var(--text-lg);
  }

  .rail__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .rail__track {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-2) var(--gutter) var(--space-5);
    /* Intentional, scoped horizontal scroll. */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  /* One dominant card with the next partially visible. */
  .card {
    flex: 0 0 min(78vw, 26rem);
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr;
    background-color: var(--surface-canvas);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .card__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card__media :global(.placeholder) {
    border-radius: 0;
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .card__name {
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--navy-800);
  }

  .card__full-name {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .card__description {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-block: var(--space-3) var(--space-2);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--border-subtle);
  }

  .card__meta dt {
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .card__meta dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .card__link {
    justify-self: start;
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--navy-600);
  }

  .rail__progress {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  @media (max-width: 40rem) {
    .rail__header {
      flex-direction: column;
      align-items: start;
    }

    /* Native swipe is the primary interaction on touch. */
    .rail__controls {
      display: none;
    }

    .card {
      flex-basis: min(84vw, 22rem);
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  /*
   * Scoped per instance rather than to the first match on the page. Astro
   * bundles this script once regardless of how many rails a page renders, so
   * a document-wide querySelector would leave every rail after the first
   * inert — silently, since nothing throws.
   */
  const initRail = (root: HTMLElement) => {
    const track = root.querySelector<HTMLElement>("[data-rail-track]");
    if (!track) return;

    const prev = root.querySelector<HTMLButtonElement>("[data-rail-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-rail-next]");
    const progress = root.querySelector<HTMLElement>("[data-rail-progress]");
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".card"));
    const lastIndex = Math.max(cards.length - 1, 0);

    /*
     * Card width plus gap only changes on resize, but reading it needs both
     * getComputedStyle and getBoundingClientRect — two forced layouts. Cache
     * it and let a ResizeObserver invalidate, instead of paying that cost on
     * every scroll frame.
     */
    let cachedStep = 0;

    const measure = () => {
      const first = cards[0];
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      cachedStep = first ? first.getBoundingClientRect().width + gap : track.clientWidth;
    };

    const activeIndex = () =>
      cachedStep > 0
        ? Math.min(lastIndex, Math.max(0, Math.round(track.scrollLeft / cachedStep)))
        : 0;

    const scrollToIndex = (index: number) => {
      track.scrollTo({
        left: Math.min(lastIndex, Math.max(0, index)) * cachedStep,
        behavior: reduced.matches ? "auto" : "smooth",
      });
    };

    let lastLabel = "";

    const update = () => {
      // Read all geometry first, then write — writing between reads would
      // force a second layout in the same frame.
      const { scrollLeft, clientWidth, scrollWidth } = track;
      const label = `${activeIndex() + 1} of ${cards.length}`;
      const atStart = scrollLeft <= 2;
      const atEnd = scrollLeft + clientWidth >= scrollWidth - 2;

      if (progress && label !== lastLabel) {
        progress.textContent = label;
        lastLabel = label;
      }
      if (prev && prev.disabled !== atStart) prev.disabled = atStart;
      if (next && next.disabled !== atEnd) next.disabled = atEnd;
    };

    let frame = 0;
    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    prev?.addEventListener("click", () => scrollToIndex(activeIndex() - 1));
    next?.addEventListener("click", () => scrollToIndex(activeIndex() + 1));

    // Arrow keys move the rail when it holds focus.
    track.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      scrollToIndex(activeIndex() + (e.key === "ArrowRight" ? 1 : -1));
    });

    track.addEventListener("scroll", scheduleUpdate, { passive: true });

    new ResizeObserver(() => {
      measure();
      scheduleUpdate();
    }).observe(track);

    measure();
    update();
  };

  document.querySelectorAll<HTMLElement>("[data-rail]").forEach(initRail);
</script>
