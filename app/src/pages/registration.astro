---
/**
 * Registration — informational only.
 *
 * Entry itself happens on RunSignup (product-owner direction 2026-07-25); this
 * page carries the eligibility rules and the change/refund policies that need
 * a home on the event's own site, and sends people out to register.
 */
import AppShell from "../layouts/AppShell.astro";
import InteriorHero from "../components/InteriorHero.astro";
import CTAGroup from "../components/CTAGroup.astro";
import Provisional from "../components/Provisional.astro";
import { registerAction, event } from "../content/event.ts";
import { distances } from "../content/distances.ts";
import {
  registrationCloseDate,
  registrationHeroImage,
  registrationPolicies,
} from "../content/registration.ts";
---

<AppShell
  title="Registration — Fort Lauderdale 13.1"
  description="Register for the Fort Lauderdale 13.1 on Sunday, November 8, 2026: half marathon, relay, 10K, and 5K entry details, eligibility, and policies."
  headerVariant="overlay"
>
  <InteriorHero
    eyebrow="Entries Open"
    title="Registration"
    subtitle="Snag your spot before it fills."
    image={registrationHeroImage}
  />

  <section class="section section--light" aria-labelledby="entry-title">
    <div class="container">
      <p class="eyebrow">2026 Entry</p>
      <h2 class="section__title" id="entry-title">Pick a distance and go</h2>
      <p class="measure reg__lede">
        Entries are handled on RunSignup. The half marathon and the 5K are
        capped, so both close when they fill — the earlier you enter, the safer
        your place.
      </p>

      <ul class="prices" role="list">
        {
          distances.map((distance) => (
            <li class="price">
              <span class="price__name">{distance.name}</span>
              <span class="price__value">
                <Provisional value={distance.price} />
              </span>
              <span class="price__start">
                Starts <Provisional value={distance.startTime} />
              </span>
            </li>
          ))
        }
      </ul>

      <div class="reg__cta">
        <CTAGroup actions={[registerAction]} />
        <p class="reg__note">
          Registration closes <Provisional value={registrationCloseDate} />.
          If space remains, race-morning registration runs 5:00 AM–5:50 AM at
          the race site.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--warm" aria-labelledby="eligibility-title">
    <div class="container">
      <p class="eyebrow">Who Can Run</p>
      <h2 class="section__title" id="eligibility-title">Eligibility</h2>
      <p class="measure elig__body">
        Half marathon participants must be at least 14 years old, and anyone
        under 18 needs a parent-signed minor waiver. Minimum ages for the relay,
        10K, and 5K are being confirmed. If you are unsure whether a distance
        suits you, email
        <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a> before
        you enter.
      </p>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="changes-title">
    <div class="container">
      <p class="eyebrow">Registration Changes</p>
      <h2 class="section__title" id="changes-title">Before you enter, know this</h2>

      <div class="policies">
        {
          registrationPolicies.map((policy) => (
            <article class="policy">
              <h3 class="policy__title">{policy.title}</h3>
              <p class="measure policy__body">
                <Provisional value={policy.body} />
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</AppShell>

<style>
  .reg__lede {
    margin-block: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .prices {
    display: grid;
    border-block-start: var(--border-width) solid var(--border-subtle);
  }

  .price {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.6fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--border-subtle);
  }

  .price__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .price__value {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .price__start {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .reg__cta {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  .reg__note {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .elig__body {
    margin-block-start: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .policies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-7) var(--space-8);
    margin-block-start: var(--space-7);
  }

  .policy__title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-2);
  }

  .policy__body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  @media (max-width: 40rem) {
    .price {
      grid-template-columns: 1fr;
      gap: var(--space-1, 0.25rem);
    }
  }
</style>
