---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Page Not Found — Fort Lauderdale 13.1"
  description="The requested Fort Lauderdale 13.1 page could not be found."
>
  <section class="section section--deepest not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <p class="eyebrow">404</p>
      <h1 id="not-found-title">That route missed the turn.</h1>
      <p class="measure">
        The page may have moved, or the link may be out of date. Head back to
        the race homepage to find your way.
      </p>
      <a class="btn btn--primary u-unstyled-link" href="/">Back to homepage</a>
    </div>
  </section>
</AppShell>

<style>
  .not-found {
    min-height: calc(100svh - var(--topbar-height));
    display: grid;
    align-items: center;
  }

  .not-found__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
</style>
